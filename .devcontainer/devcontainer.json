{
  "name": "Bexley Power Platform service",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" }
  },
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium && dotnet tool install --global Microsoft.PowerApps.CLI.Tool",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "github.copilot-chat",
        "microsoft-isvexptools.powerplatform-vscode",
        "ms-copilotstudio.vscode-copilotstudio",
        "redhat.vscode-yaml"
      ]
    }
  }
}
